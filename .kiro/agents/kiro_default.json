{
  "name": "kiro_default",
  "description": "Global default agent for the Cauã Loves Candies Flutter + Flame project. Acts as the Main Loop: auto-approves read/search and non-destructive shell commands (flutter/dart read-only, git); the only agent allowed to commit and push, following AGENTS.md governance. Destructive commands stay denied.",
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code"
  ],
  "allowedTools": [
    "read",
    "write",
    "grep",
    "glob",
    "code"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "./.env",
        "./**/.env",
        "./**/*.pem",
        "./**/credentials"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "kiro-cli chat --agent .* --no-interactive.*",
        "mkdir",
        "mkdir -p .*",
        "mv .*",
        "cp .*",
        "touch .*",
        "ls",
        "ls .*",
        "cat .*",
        "find .*",
        "grep .*",
        "echo .*",
        "flutter pub get",
        "flutter analyze.*",
        "flutter --version",
        "flutter doctor.*",
        "dart --version",
        "dart analyze.*",
        "dart format.*",
        "git add .*",
        "git status",
        "git status .*",
        "git diff",
        "git diff .*",
        "git log",
        "git log .*",
        "git commit.*",
        "git push.*",
        "git worktree.*",
        "git branch.*",
        "git switch.*",
        "git pull.*"
      ],
      "deniedCommands": [
        "rm",
        "rm .*",
        "rm -rf .*",
        "dd .*",
        "mkfs.*",
        "fdisk .*",
        "parted .*",
        "gdisk .*",
        "shred .*",
        "wipe .*",
        "sudo .*",
        "doas .*",
        "su .*",
        "chmod .*",
        "chown .*",
        "chgrp .*",
        "nc .*",
        "netcat .*",
        "ncat .*",
        "socat .*",
        "curl .*",
        "wget .*",
        "ssh .*",
        "scp .*",
        "sftp .*",
        "rsync .*",
        "telnet .*",
        "ftp .*",
        "shutdown .*",
        "reboot .*",
        "poweroff .*",
        "init .*",
        "halt .*",
        "kill .*",
        "killall .*",
        "pkill .*",
        "eval .*",
        "exec .*",
        "bash -c .*",
        "sh -c .*",
        "zsh -c .*",
        "python -c .*",
        "python3 -c .*",
        "perl -e .*",
        "ruby -e .*",
        "php -r .*",
        ".*git reset --hard.*",
        ".*git push --force.*",
        ".*git commit --no-verify.*"
      ]
    }
  }
}